# ── Ollama (local LLM runtime; OpenAI-compatible API) ───────────────
# RAGAS talks to Ollama through its OpenAI-compatible endpoint, which lives
# at `${OLLAMA_BASE_URL}/v1`. Before running an eval:
#   1. `ollama serve` is running
#   2. the models below are pulled: `ollama pull mistral`, `ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://localhost:11434

# Judge LLM — the model that scores the eval. Its choice and version are part
# of the result; a weaker judge gives noisier scores.
OLLAMA_JUDGE_MODEL=mistral

# Embedding model — used by metrics that compare semantic similarity
# (e.g. answer relevancy).
OLLAMA_EMBED_MODEL=nomic-embed-text
